
# Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password has special characters (@ : / # ?), URL-encode them
# (for example @ becomes %40), or the URL will be parsed wrongly.

# Used by migrations and admin tasks (owner role). Until Phase 1 creates
# our dedicated roles, this points at the local superuser.
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@localhost:5432/ledger_dev?sslmode=disable

# Used by the API at runtime. In Phase 1 this switches to the
# least-privilege "ledger_app" role. Same value as admin for now.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ledger_dev?sslmode=disable

# API settings (used from Phase 8)
PORT=3000
API_KEY=CHANGE_ME